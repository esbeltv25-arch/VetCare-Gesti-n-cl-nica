// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id            String    @id
  name          String
  phone         String
  email         String
  address       String
  since         DateTime
  loyaltyPoints Int       @default(0)
  avatarColor   String
  pets          Pet[]
  invoices      Invoice[]
  appointments  Appointment[]
}

model Pet {
  id                String      @id
  name              String
  species           String
  breed             String
  birthDate         DateTime
  weight            Float
  sex               String
  microchip         String      @default("")
  sterilized        Boolean     @default(false)
  photoUrl          String
  galleryPhotos     String      @default("[]")  // JSON array de base64 strings
  allergies         String      @default("[]")
  chronicConditions String      @default("[]")
  customFields      String      @default("[]")  // JSON: [{label, value}]
  status            String      @default("Sano")
  lastVisit         DateTime?
  client            Client      @relation(fields: [clientId], references: [id])
  clientId          String
  vaccines          Vaccine[]
  appointments      Appointment[]
  invoices          Invoice[]
  consultations     Consultation[]
  hospitalizations  Hospitalization[]
}

// Singleton: personalización de la clínica (colores, nombre de marca, etiquetas, modo oscuro, layout, idioma)
model ClinicSettings {
  id             String   @id @default("singleton")
  brandName      String   @default("VetCare")
  brandSubtitle  String   @default("Gestión clínica")
  primaryColor   String   @default("#10b981")  // emerald por defecto
  accentColor    String   @default("#7c3aed")  // violeta
  darkMode       Boolean  @default(false)
  moduleLabels   String   @default("{}")  // JSON overrides de etiquetas del sidebar
  moduleLayout   String   @default("{}")  // JSON: {order: string[], hidden: string[]}
  language       String   @default("es")  // idioma: es, en, fr, de, pt, pt-BR, it, ca
  updatedAt      DateTime @updatedAt
}

model Vaccine {
  id      String   @id @default(cuid())
  name    String
  date    DateTime
  nextDue DateTime?
  pet     Pet      @relation(fields: [petId], references: [id])
  petId   String
}

model Vet {
  id                String       @id
  name              String
  role              String
  specialty         String
  phone             String
  email             String
  shift             String
  active            Boolean       @default(true)
  appointmentsToday Int          @default(0)
  rating            Float         @default(0)
  avatarColor       String
  appointments      Appointment[]
  consultations     Consultation[]
  shiftLogsAsReporter ShiftLog[] @relation("ReporterVetShiftLogs")
  shiftLogsAsIncoming ShiftLog[] @relation("IncomingVetShiftLogs")
  attendingFor      Hospitalization[]
}

model Appointment {
  id       String   @id @default(cuid())
  date     String
  time     String
  duration Int
  reason   String
  type     String
  status   String   @default("Pendiente")
  pet      Pet      @relation(fields: [petId], references: [id])
  petId    String
  client   Client   @relation(fields: [clientId], references: [id])
  clientId String
  vet      Vet      @relation(fields: [vetId], references: [id])
  vetId    String
}

model InventoryItem {
  id         String  @id
  name       String
  category   String
  stock      Int
  minStock   Int
  unit       String
  expiryDate String?
  supplier   String
  price      Float
  lot        String
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  date          String
  status        String        @default("Pendiente")
  paymentMethod String?
  client        Client        @relation(fields: [clientId], references: [id])
  clientId      String
  pet           Pet           @relation(fields: [petId], references: [id])
  petId         String
  items         InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  qty         Int
  unitPrice   Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId   String
}

model Consultation {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  pet          Pet      @relation(fields: [petId], references: [id])
  petId        String
  vet          Vet      @relation(fields: [vetId], references: [id])
  vetId        String
  appointmentId String?
  // SOAP
  subjective   String   @default("")
  objective    String   @default("")
  assessment   String   @default("")
  plan         String   @default("")
  reason       String   @default("")
  // AI metadata
  audioTranscript String?
  aiGenerated     Boolean  @default(false)
  aiSummary       String?
  // Vitals
  weightKg     Float?
  temperatureC Float?
  heartRate    Int?
  respiratoryRate Int?
  bodyConditionScore Float?
  // Status
  status       String   @default("borrador") // borrador | finalizada
  diagnoses   Diagnosis[]
  treatments  Treatment[]
}

model Diagnosis {
  id             String   @id @default(cuid())
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  consultationId String
  name           String
  icdCode        String?
  confidence     Float?
  isPrimary      Boolean  @default(false)
  isAiSuggested  Boolean  @default(false)
  accepted       Boolean  @default(false)
  notes          String?
}

model Treatment {
  id             String   @id @default(cuid())
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  consultationId String
  drugName       String
  doseMg         Float
  dosePerKg      Float?
  frequency      String
  duration       String
  route          String
  notes          String?
  isAiSuggested  Boolean  @default(false)
  accepted       Boolean  @default(false)
}

// Internación / guardia: bitacora en tiempo real para auxiliares nocturnos y fines de semana
model Hospitalization {
  id               String   @id @default(cuid())
  pet              Pet      @relation(fields: [petId], references: [id])
  petId            String
  attendingVet     Vet      @relation(fields: [attendingVetId], references: [id])
  attendingVetId   String
  admissionDate    DateTime @default(now())
  dischargeDate    DateTime?
  cage             String   // ej. "Box 3", "Jaula A-12"
  status           String   @default("active") // active | observation | discharged
  reason           String   // motivo de internación
  weightKg         Float?
  feedingPlan      String?  // plan de alimentación
  fluidTherapy     String?  // fluidoterapia activa
  notes            String?  // notas generales del alta
  shiftLogs        ShiftLog[]
}

model ShiftLog {
  id                String   @id @default(cuid())
  hospitalization   Hospitalization @relation(fields: [hospitalizationId], references: [id])
  hospitalizationId String
  timestamp         DateTime @default(now())
  type              String   // medication | incident | behavior | vital | note | handover
  reporterVet       Vet      @relation("ReporterVetShiftLogs", fields: [reporterVetId], references: [id])
  reporterVetId     String
  incomingVet       Vet?     @relation("IncomingVetShiftLogs", fields: [incomingVetId], references: [id])
  incomingVetId     String?

  // Common
  content           String

  // Medication
  drugName          String?
  doseMg            Float?
  dosePerKg         Float?
  route             String?

  // Vitals
  temperatureC      Float?
  heartRate         Int?
  respiratoryRate   Int?
  weightKg          Float?
  appetite           String?  // come | no come | poco | voluntario
  hydration          String?  // normohidratado | deshidratado | sobrehidratado
  urination          String?  // normal | oliguria | anuria | poliuria
  feces              String?  // normal | diarrea | estreñimiento | ausente

  // Incident severity
  severity          String?  // info | warning | critical
}
