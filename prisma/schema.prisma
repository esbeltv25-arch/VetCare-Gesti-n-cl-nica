// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id            String    @id
  name          String
  phone         String
  email         String
  address       String
  since         DateTime
  loyaltyPoints Int       @default(0)
  avatarColor   String
  pets          Pet[]
  invoices      Invoice[]
  appointments  Appointment[]
}

model Pet {
  id                String      @id
  name              String
  species           String
  breed             String
  birthDate         DateTime
  weight            Float
  sex               String
  microchip         String      @default("")
  sterilized        Boolean     @default(false)
  photoUrl          String
  allergies         String      @default("[]")
  chronicConditions String      @default("[]")
  status            String      @default("Sano")
  lastVisit         DateTime?
  client            Client      @relation(fields: [clientId], references: [id])
  clientId          String
  vaccines          Vaccine[]
  appointments      Appointment[]
  invoices          Invoice[]
  consultations     Consultation[]
}

model Vaccine {
  id      String   @id @default(cuid())
  name    String
  date    DateTime
  nextDue DateTime?
  pet     Pet      @relation(fields: [petId], references: [id])
  petId   String
}

model Vet {
  id                String       @id
  name              String
  role              String
  specialty         String
  phone             String
  email             String
  shift             String
  active            Boolean       @default(true)
  appointmentsToday Int          @default(0)
  rating            Float         @default(0)
  avatarColor       String
  appointments      Appointment[]
  consultations     Consultation[]
}

model Appointment {
  id       String   @id @default(cuid())
  date     String
  time     String
  duration Int
  reason   String
  type     String
  status   String   @default("Pendiente")
  pet      Pet      @relation(fields: [petId], references: [id])
  petId    String
  client   Client   @relation(fields: [clientId], references: [id])
  clientId String
  vet      Vet      @relation(fields: [vetId], references: [id])
  vetId    String
}

model InventoryItem {
  id         String  @id
  name       String
  category   String
  stock      Int
  minStock   Int
  unit       String
  expiryDate String?
  supplier   String
  price      Float
  lot        String
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  date          String
  status        String        @default("Pendiente")
  paymentMethod String?
  client        Client        @relation(fields: [clientId], references: [id])
  clientId      String
  pet           Pet           @relation(fields: [petId], references: [id])
  petId         String
  items         InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  qty         Int
  unitPrice   Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId   String
}

model Consultation {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  pet          Pet      @relation(fields: [petId], references: [id])
  petId        String
  vet          Vet      @relation(fields: [vetId], references: [id])
  vetId        String
  appointmentId String?
  // SOAP
  subjective   String   @default("")
  objective    String   @default("")
  assessment   String   @default("")
  plan         String   @default("")
  reason       String   @default("")
  // AI metadata
  audioTranscript String?
  aiGenerated     Boolean  @default(false)
  aiSummary       String?
  // Vitals
  weightKg     Float?
  temperatureC Float?
  heartRate    Int?
  respiratoryRate Int?
  bodyConditionScore Float?
  // Status
  status       String   @default("borrador") // borrador | finalizada
  diagnoses   Diagnosis[]
  treatments  Treatment[]
}

model Diagnosis {
  id             String   @id @default(cuid())
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  consultationId String
  name           String
  icdCode        String?
  confidence     Float?
  isPrimary      Boolean  @default(false)
  isAiSuggested  Boolean  @default(false)
  accepted       Boolean  @default(false)
  notes          String?
}

model Treatment {
  id             String   @id @default(cuid())
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  consultationId String
  drugName       String
  doseMg         Float
  dosePerKg      Float?
  frequency      String
  duration       String
  route          String
  notes          String?
  isAiSuggested  Boolean  @default(false)
  accepted       Boolean  @default(false)
}
