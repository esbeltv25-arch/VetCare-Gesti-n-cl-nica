# URL de la base de datos
# Para desarrollo local con SQLite:
# DATABASE_URL=file:./db/custom.db

# Para producción (Render/Vercel/Railway) con PostgreSQL gratuito en Neon.tech:
# 1. Crea cuenta en https://neon.tech (gratis, 0.5GB, no expira)
# 2. Crea un proyecto y copia la URL de conexión
# 3. Pégala aquí o en las variables de entorno del hosting:
# DATABASE_URL=postgresql://neondb_owner:npg_xxx@ep-xxx.neon.tech/vetcare?sslmode=require

DATABASE_URL=file:/home/z/my-project/db/custom.db
